{
  "name": "@paylink/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src test scripts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "openapi": "tsx src/openapi/generate.ts",
    "scenario": "tsx --env-file-if-exists=../../.env scripts/scenario.ts",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "db:status": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate status"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@paylink/shared": "workspace:*",
    "@prisma/client": "^6.0.0",
    "@scalar/express-api-reference": "*",
    "@stellar/stellar-sdk": "*",
    "argon2": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "express-rate-limit": "*",
    "helmet": "*",
    "nodemailer": "^10.0.14",
    "pg": "^8.13.0",
    "pino": "*",
    "pino-http": "*",
    "prisma": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "*",
    "@testcontainers/postgresql": "*",
    "@types/cookie-parser": "*",
    "@types/cors": "*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "*",
    "@types/supertest": "*",
    "eslint": "*",
    "fast-check": "*",
    "pino-pretty": "*",
    "supertest": "*",
    "tsup": "*",
    "tsx": "*",
    "typescript": "^7.0.2",
    "typescript-eslint": "*",
    "vitest": "*"
  }
}
