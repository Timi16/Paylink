{
  "name": "paylink",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @paylink/api dev",
    "dev:web": "pnpm --filter @paylink/web dev",
    "dev:worker": "pnpm --filter @paylink/api dev:worker",
    "build": "pnpm --filter @paylink/api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @paylink/api test",
    "format": "prettier --write .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "scenario": "pnpm --filter @paylink/api scenario",
    "seed": "pnpm --filter @paylink/api seed",
    "build:web": "pnpm --filter @paylink/web build"
  },
  "devDependencies": {
    "prettier": "^3.3.0"
  }
}
